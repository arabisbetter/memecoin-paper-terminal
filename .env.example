NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only market/risk providers.
HELIUS_API_KEY=
JUPITER_API_KEY=
SOLANA_RPC_URL=

# Part 4 — Sumsub. Never expose these with NEXT_PUBLIC_* names.
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_WEBHOOK_SECRET=
SUMSUB_LEVEL_NAME=
SUMSUB_AUTO_AML_RECHECK=false

# Part 4/5 — Turnkey custody/signing. Server-side secret manager only.
TURNKEY_API_PUBLIC_KEY=
TURNKEY_API_PRIVATE_KEY=
TURNKEY_ORGANIZATION_ID=
TURNKEY_POLICY_ID=

# Vercel/Next server-side privileged Supabase access for future real-money signer routes.
SUPABASE_SERVICE_ROLE_KEY=

# Extra application kill switch. Keep false until legal/compliance/custody/treasury launch review is complete.
PAPER_REAL_MONEY_SERVER_ENABLED=false

# PAPER evaluation/funded safety switches also live in the database and default OFF for real money.
# Enabling the server switch alone is never sufficient; all database launch gates must also be true.

# $PAPER token is deferred for v1. Leave these empty unless product scope changes after review.
NEXT_PUBLIC_PROJECT_TOKEN_SYMBOL=$PAPER
NEXT_PUBLIC_PROJECT_TOKEN_MINT=
NEXT_PUBLIC_PROJECT_TOKEN_BUY_URL=
NEXT_PUBLIC_PROJECT_TOKEN_DESCRIPTION=
