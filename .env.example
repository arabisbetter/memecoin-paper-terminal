NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
HELIUS_API_KEY=
JUPITER_API_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Helius/Jupiter are server-only. Configure the same names as Supabase Edge Function secrets for Part 2 enrichment/fallbacks.
# PAPER evaluation/funded safety switches live in the database and default OFF for real money.
# Turnkey/API private keys must be stored only in server-side secret managers and must never use NEXT_PUBLIC_* names.
# TURNKEY_PRIVATE_KEY=DO_NOT_COMMIT
# TURNKEY_PUBLIC_KEY=
# TURNKEY_ORGANIZATION_ID=

# $PAPER token is deferred for v1. Leave these empty unless the product scope changes after review.
NEXT_PUBLIC_PROJECT_TOKEN_SYMBOL=$PAPER
NEXT_PUBLIC_PROJECT_TOKEN_MINT=
NEXT_PUBLIC_PROJECT_TOKEN_BUY_URL=
NEXT_PUBLIC_PROJECT_TOKEN_DESCRIPTION=
